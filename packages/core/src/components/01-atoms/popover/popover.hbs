<ct-popover
  theme="{{theme}}"
  trigger-text="{{triggerText}}"
  {{#if triggerUrl}}trigger-url="{{triggerUrl}}"{{/if}}
  {{#if triggerNewWindow}}trigger-new-window{{/if}}
  {{#if triggerExternal}}trigger-external{{/if}}
  {{#if group}}group="{{group}}"{{/if}}
  content="{{content}}"
  {{#if contentTop}}content-top="{{contentTop}}"{{/if}}
  {{#if contentBottom}}content-bottom="{{contentBottom}}"{{/if}}
  {{#if open}}open{{/if}}
  {{#if modifierClass}}modifier-class="{{modifierClass}}"{{/if}}
></ct-popover>
