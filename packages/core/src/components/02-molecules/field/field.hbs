<ct-field
  theme="{{theme}}"
  type="{{type}}"
  {{#if title}}title="{{title}}"{{/if}}
  {{#if titleDisplay}}title-display="{{titleDisplay}}"{{/if}}
  {{#if titleSize}}title-size="{{titleSize}}"{{/if}}
  {{#if label}}label="{{label}}"{{/if}}
  {{#if description}}description="{{description}}"{{/if}}
  name="{{name}}"
  {{#if value}}value="{{value}}"{{/if}}
  {{#if id}}id="{{id}}"{{/if}}
  {{#if isInvalid}}is-invalid{{/if}}
  {{#if isDisabled}}is-disabled{{/if}}
  {{#if isRequired}}is-required{{/if}}
  {{#if requiredText}}required-text="{{requiredText}}"{{/if}}
  {{#if orientation}}orientation="{{orientation}}"{{/if}}
  {{#if isInline}}is-inline{{/if}}
  {{#if placeholder}}placeholder="{{placeholder}}"{{/if}}
  {{#if isMultiple}}is-multiple{{/if}}
  {{#if checked}}checked{{/if}}
  {{#if message}}message="{{message}}"{{/if}}
  {{#if prefix}}prefix="{{prefix}}"{{/if}}
  {{#if suffix}}suffix="{{suffix}}"{{/if}}
  {{#if modifierClass}}modifier-class="{{modifierClass}}"{{/if}}
>
  {{{children}}}
</ct-field>
