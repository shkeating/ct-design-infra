<ct-video-player
  theme="{{theme}}"
  {{#if frameTitle}}frame-title="{{frameTitle}}"{{/if}}
  {{#if poster}}poster="{{poster}}"{{/if}}
  {{#if sourceUrl}}source-url="{{sourceUrl}}"{{/if}}
  {{#if sourceType}}source-type="{{sourceType}}"{{/if}}
  {{#if width}}width="{{width}}"{{/if}}
  {{#if height}}height="{{height}}"{{/if}}
  {{#if verticalSpacing}}vertical-spacing="{{verticalSpacing}}"{{/if}}
  {{#if modifierClass}}modifier-class="{{modifierClass}}"{{/if}}
  {{#if embeddedSource}}embedded-source="{{embeddedSource}}"{{/if}}
  {{#if rawSource}}raw-source="{{rawSource}}"{{/if}}
  {{#if transcriptText}}transcript-text="{{transcriptText}}"{{/if}}
  {{#if transcriptAriaLabel}}transcript-aria-label="{{transcriptAriaLabel}}"{{/if}}
  {{#if transcriptTitle}}transcript-title="{{transcriptTitle}}"{{/if}}
  {{#if transcriptUrl}}transcript-url="{{transcriptUrl}}"{{/if}}
  {{#if transcriptNewWindow}}transcript-new-window{{/if}}
  {{#if transcriptExternal}}transcript-external{{/if}}
  {{#if transcriptContent}}transcript-content="{{transcriptContent}}"{{/if}}
  {{#if transcriptExpandText}}transcript-expand-text="{{transcriptExpandText}}"{{/if}}
  {{#if transcriptCollapseText}}transcript-collapse-text="{{transcriptCollapseText}}"{{/if}}
></ct-video-player>
